{
  "_doc": "Default bindings. Keyboard uses physical key codes (layout-independent). Remapping UI comes in phase 4.",
  "deadzone": 0.25,
  "actions": {
    "move_left":  { "keys": ["A", "Left"],  "joy_buttons": ["dpad_left"],  "joy_axes": [["left_x", -1]] },
    "move_right": { "keys": ["D", "Right"], "joy_buttons": ["dpad_right"], "joy_axes": [["left_x", 1]] },
    "move_up":    { "keys": ["W", "Up"],    "joy_buttons": ["dpad_up"],    "joy_axes": [["left_y", -1]] },
    "move_down":  { "keys": ["S", "Down"],  "joy_buttons": ["dpad_down"],  "joy_axes": [["left_y", 1]] },
    "jump":       { "keys": ["Space", "K"], "joy_buttons": ["a"] },
    "action":     { "keys": ["J", "E", "Enter"], "joy_buttons": ["x"] },
    "block":      { "keys": ["L", "Shift"], "joy_buttons": ["left_shoulder", "right_shoulder"] },
    "pause":      { "keys": ["Escape", "P"], "joy_buttons": ["start"] },
    "debug_toggle_burden": { "keys": ["B"], "joy_buttons": ["y"] }
  }
}
