; Engine configuration file.
; Pilgrim in Progress. Godot 4.7.2-stable, GDScript, Compatibility renderer.

config_version=5

[application]

config/name="Pilgrim in Progress"
config/description="A pixel-art pilgrimage after John Bunyan's The Pilgrim's Progress."
config/version="0.0.1"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.113725, 0.0823529, 0.188235, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Build="*res://scripts/build_info.gd"
ScreenFit="*res://scripts/screen_fit.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/pixelify-sans-latin-400-normal.woff2"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
2d/default_gravity=900.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.113725, 0.0823529, 0.188235, 1)
textures/vram_compression/import_etc2_astc=true
